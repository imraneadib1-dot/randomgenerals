{
  "name": "randomgenerals-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "iOS and Android shell for RandomGenerals AI, built with Capacitor.",
  "scripts": {
    "sync": "cap sync",
    "ios": "cap add ios && cap sync ios && cap open ios",
    "android": "cap add android && cap sync android && cap open android",
    "icons": "python ../tools/make_icons.py --ios"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.4",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/network": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
