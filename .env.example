# Copy this file to `.env` and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
#
# `.env` is gitignored; this example is committed so anyone setting the
# project up knows which variables exist.
#
# NOTE ON NAMING: this is a Flask/Python app, not Next.js - there is no
# NEXT_PUBLIC_* convention here, and nothing in this file is exposed to
# the browser. Stripe's *publishable* key isn't needed at all: checkout
# happens on Stripe's own hosted page (see /api/subscribe), which is
# also what keeps this app out of PCI scope.

# ----------------------------------------------------------------------
# Local AI (required) - the app talks to Ollama on this machine.
# ----------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434

# Ollama Cloud, for running with no machine of your own.
#
# The cloud serves the identical native API, so pointing OLLAMA_URL at it
# and adding a key is the whole change - the app streams from it exactly
# as it streams from a local install. Cloud model names end in -cloud
# (gpt-oss:120b-cloud and so on) and /api/tags lists whatever your key
# can reach, so the model picker fills itself in.
#
#   OLLAMA_URL=https://ollama.com
#   OLLAMA_API_KEY=<https://ollama.com/settings/keys>
#
# Note this changes what the app can honestly claim: with a remote
# endpoint the channel is labelled "Ollama Cloud" rather than "On this
# machine", because prompts do leave the device.
OLLAMA_API_KEY=

# ----------------------------------------------------------------------
# pip 1.0 - the app's own model, served by pip_server.py.
#
# The engine needs a GPU; the web app does not. So this is the address
# of whichever machine runs `python pip_server.py`: the same one in
# development, another one - reached over a tunnel or a private network
# - when the web app is on a host with no GPU.
#
# Left as it is, the app looks for an engine on this machine. Set it
# empty to switch the channel off; the backup channels below then answer
# everything.
PIP_ENGINE_URL=http://127.0.0.1:8765/v1

# Required by the engine when it is set there too. Set both whenever the
# engine is reachable from anywhere but localhost.
PIP_ENGINE_KEY=

# How many tokens of conversation one request may carry. The base model
# reads 262,144; the default is what an 8 GB card holds comfortably.
PIP_CONTEXT_TOKENS=32768


# ----------------------------------------------------------------------
# Owner-only stats page (optional)
# ----------------------------------------------------------------------
# The email you sign in with. Set it and /stats shows signups, usage by
# bay, which model answered and credits consumed - all computed from the
# database, with nothing tracked or logged to produce it.
#
# Leave it blank and /stats returns 404 for everyone, including you. That
# is the safe default: the alternative is a public page listing your
# revenue and usage. Traffic figures (visits, countries, referrers) are
# not here - those live in the Cloudflare dashboard.
ADMIN_EMAIL=

# ----------------------------------------------------------------------
# Flask session signing (required before deploying)
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------------------------------------------
SECRET_KEY=

# Where this site is reached from the internet, no trailing slash.
# Used in emails, the sitemap, and as the base of the video webhook
# callback (which needs public https). Defaults to the production
# domain; set it to your own when hosting elsewhere.
#PUBLIC_SITE_URL=https://randomgenerals.com

# ----------------------------------------------------------------------
# Stripe subscriptions - $3.99/mo Pro plan. OPTIONAL: the app runs fine
# without these, it just can't sell Pro.
#
# IMPORTANT: paste the WHOLE key. A truncated value like "sk_test_51..."
# is worse than leaving this blank - the app would treat billing as
# configured, and your customer would hit "Invalid API Key" at the
# checkout button instead of an honest "not available yet". billing_live()
# screens for obvious placeholders, but don't rely on that.
#
#   1. https://dashboard.stripe.com/register - create the account.
#      Settings -> Payouts: add the bank account that receives money.
#   2. Product catalog -> add product "Pro", recurring price $3.99/month.
#      Copy its Price ID (starts "price_") into STRIPE_PRICE_ID_PRO.
#   3. Developers -> API keys -> copy the SECRET key ("sk_test_" while
#      testing, "sk_live_" in production). It is ~100 characters.
#   4. Webhook, so a completed payment actually flips the account to Pro:
#        Local:     stripe listen --forward-to localhost:5000/api/billing/webhook
#        Deployed:  Developers -> Webhooks -> add endpoint
#                   https://yourdomain/api/billing/webhook
#                   events: checkout.session.completed,
#                           customer.subscription.updated,
#                           customer.subscription.deleted
#      Copy its signing secret ("whsec_") below. Without it the webhook
#      refuses every request - it cannot verify a callback really came
#      from Stripe, and acting on an unverified one would let anyone
#      grant themselves Pro.
# ----------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------
# Google sign-in (optional). Email/password signup works without it.
# https://console.cloud.google.com -> OAuth client ID (Web application),
# authorised redirect URI: http://127.0.0.1:5000/api/auth/google/callback
# ----------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------
# Image generation (optional key, better pictures)
# ----------------------------------------------------------------------
# The default image backend is keyless: Pollinations, which serves SANA
# and needs no account. It caps output at about 0.59 megapixels whatever
# size is asked for, and the app resamples up to the size it promised.
#
# Cloudflare Workers AI runs FLUX.1-schnell on a standing free daily
# allocation, and is used automatically for every picture when both of
# these are set. Account id and a token with the Workers AI permission:
#   https://dash.cloudflare.com/profile/api-tokens
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ----------------------------------------------------------------------
# Dev-only escape hatch. "1" lets an account self-upgrade to Pro with no
# payment, so the plan UI can be exercised before Stripe exists. MUST
# stay unset anywhere other people can reach - it is a free-Pro button.
# ----------------------------------------------------------------------
ALLOW_MOCK_UPGRADE=

# Set to 1 when served over real HTTPS so session cookies are marked
# Secure. Leave blank for local http, or sign-in breaks.
FORCE_HTTPS_COOKIES=

# ----------------------------------------------------------------------
# ----------------------------------------------------------------------

# Set to 1 ONLY when something else terminates connections in front
# of this app - a Cloudflare tunnel, nginx, Render's router. It makes
# Flask trust X-Forwarded-Proto/Host, which Google sign-in needs to
# build a redirect_uri matching the one registered in Cloud Console.
# With no proxy in front, leave it unset: those headers would then be
# attacker-controlled.
TRUST_PROXY=

# --- pip 2 (the Pro model) ------------------------------------------------
# Claude Haiku 5.5 through Anthropic's API, shown to people as "pip 2".
# Pro accounts answer with it by default; Groq (Turbo) answers when it
# cannot. Without a key, Pro simply stays on Turbo. See anthropic_api.py.
#   ANTHROPIC_API_KEY     from console.anthropic.com
#   ANTHROPIC_DAILY_USD   spending ceiling per UTC day (default 3.00)
ANTHROPIC_API_KEY=
ANTHROPIC_DAILY_USD=3

# --- Kelviq (subscriptions - the payment provider) ----------------------
# Used FIRST when KELVIQ_API_KEY and KELVIQ_PLAN_PRO are set; Paddle and
# Stripe below are only fallbacks. Kelviq is a merchant of record (it is
# the seller, handles VAT/sales tax and chargebacks).
#   KELVIQ_API_KEY         server key from the Kelviq dashboard
#   KELVIQ_PLAN_PRO        identifier of the Pro plan in Kelviq
#   KELVIQ_WEBHOOK_SECRET  signing secret of the webhook endpoint, which is
#                          https://<your domain>/api/billing/kelviq/webhook
#                          (subscribe it to subscription.* and invoice.paid)
#   KELVIQ_ENV             production (default) or sandbox
#   KELVIQ_CHARGE_PERIOD   MONTHLY (default), YEARLY, ...
KELVIQ_API_KEY=
KELVIQ_PLAN_PRO=
KELVIQ_WEBHOOK_SECRET=
KELVIQ_ENV=production
KELVIQ_CHARGE_PERIOD=MONTHLY

# --- Paddle (subscriptions) --------------------------------------------
# Use these INSTEAD of the Stripe keys above if you are selling from a
# country Stripe does not support - Morocco among them. Paddle is a
# merchant of record: they are legally the seller, handle VAT/sales tax
# worldwide, and pay out to any non-sanctioned country.
#
# When PADDLE_API_KEY and PADDLE_PRICE_ID_PRO are both set, the app uses
# Paddle for checkout and ignores Stripe.
#
# Sandbox and production are separate systems with separate keys, prices
# and dashboards - a sandbox price id is meaningless in production.
#
# EXACTLY "sandbox" or "production". Nothing else is a Paddle
# environment. "pro" was set here once and everything downstream took
# the else-branch: production keys sent to sandbox-api.paddle.com, and
# Paddle.js handed an environment it cannot start with. Checkout failed
# for everybody and nothing said so. paddle_billing.environment() now
# normalises the obvious near-misses and complains about the rest, but
# spell it correctly and none of that has to happen.
PADDLE_ENV=sandbox
# pdl_sdbx_... in sandbox, pdl_live_... in production. Reads, refunds and
# charges - never put this in the browser or paste it into a chat.
PADDLE_API_KEY=
PADDLE_PRICE_ID_PRO=
# From the notification destination, NOT the API key section. Without it
# the webhook refuses everything, which means payments succeed and
# nobody is upgraded.
PADDLE_WEBHOOK_SECRET=
# Browser-side token. Unlike the API key this one is meant to be
# public - it ships inside the page. Paddle's checkout is an overlay
# drawn by Paddle.js rather than a page to redirect to, and Paddle.js
# will not start without it, so Upgrade silently does nothing.
# Paddle > Developer tools > Authentication > Client-side tokens.
PADDLE_CLIENT_TOKEN=

# ----------------------------------------------------------------------
# Video generation (videogen.py) - the engine and its backends.
# ----------------------------------------------------------------------
# Every clip spends real money at whichever provider makes it, so the
# bay is Pro-only and capped at a hard count per day, kept in its own
# table rather than against credits: credits refill on a timer and this
# cost does not. Leave every key below blank and the bay shows as not
# set up, costing nothing.
#
# Backends are tried in this order: Higgsfield, PixVerse, Hugging Face,
# Tripo. Jobs survive restarts (they live in the database), results are
# copied to static/video/generated/ and checked before they are shown,
# and a failed clip is never counted against anyone's allowance.

# Higgsfield Cloud - the primary backend. One key gives every model the
# bay offers: Kling, Veo 3.1, Seedance, Sora 2, Hailuo, Wan, and
# Higgsfield's own DoP for image-to-video. Make an account and a key
# pair (an id and a secret) at:
#   https://cloud.higgsfield.ai
# Both halves are needed. The docs' own spelling (HF_API_KEY_ID /
# HF_API_KEY_SECRET) and the SDK's (HF_KEY=id:secret) are accepted too.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# How many Higgsfield jobs this server keeps running at once. Their
# limit is per account and per plan and is shown only in their
# dashboard (4 on the starter plan); set this to match and requests
# past it queue here instead of being refused there. Default 4.
#HIGGSFIELD_MAX_CONCURRENT=4

# Submissions per minute from this server, a guard against a runaway
# loop rather than a mirror of any published limit. Default 20.
#HIGGSFIELD_SUBMITS_PER_MINUTE=20

# Override the API host (their docs say api.higgsfield.ai; the SDKs use
# platform.higgsfield.ai; both serve the same routes). Also how the
# checks point the client at a fake. Leave unset.
#HIGGSFIELD_API_BASE=https://api.higgsfield.ai

# Webhooks: when PUBLIC_SITE_URL is https, each job is submitted with a
# callback so the provider can say "done" the moment it is, instead of
# waiting for the next poll. The callback carries no signature, so it
# only tells the engine to poll now - the result always comes from the
# provider's status endpoint. Set to 0 to submit without callbacks.
#VIDEO_WEBHOOKS=1

# Result checking needs ffprobe (part of ffmpeg) on the PATH to verify
# the real resolution and duration against what was asked. Without it
# the check stops at "is this a video file at all".
#   apt install ffmpeg      /      winget install Gyan.FFmpeg

# PixVerse - the second backend. Roughly $0.13 for a five-second clip
# through a reseller, up to $0.15/sec direct; no free tier.
#   https://platform.pixverse.ai
PIXVERSE_API_KEY=

# Free-tier video generation (hfvideo.py).
# A free Hugging Face account, no card. Create a FINE-GRAINED token
# with the "Make calls to Inference Providers" permission:
#   https://huggingface.co/settings/tokens
#
# Used only when no paid backend has a key. The free allowance is
# monthly and was measured at about three clips site-wide, so the bay
# tells people when it runs out rather than showing an error.
HF_TOKEN=

# ----------------------------------------------------------------------
# 3D models from a picture or a description (model3d.py, TRELLIS.2)
# ----------------------------------------------------------------------
# Microsoft's TRELLIS.2 (MIT licence): one picture in, a textured GLB
# out. A description is drawn first (imagegen.py), then modelled. It
# needs a 24 GB NVIDIA GPU, so it always runs somewhere else - these
# pick where, tried in order, comma-separated:
#   hf_space  the free Hugging Face Space microsoft/TRELLIS.2. No key
#             needed; HF_TOKEN above raises the shared daily GPU quota.
#   fal       fal.ai, PAID: $0.25 / $0.30 / $0.35 per model at
#             512 / 1024 / 1536. Needs FAL_KEY.
#   selfhost  TRELLIS.2's own app.py on your GPU machine, at
#             TRELLIS_SELFHOST_URL (e.g. http://10.0.0.5:7860).
# A provider that is busy or out of quota hands the job to the next.
TRELLIS_PROVIDERS=hf_space
FAL_KEY=
TRELLIS_SELFHOST_URL=
# Optional tuning (defaults shown):
# TRELLIS_SPACE=microsoft/TRELLIS.2
# MODEL3D_TIMEOUT=600          seconds before a job is given up
# MODEL3D_PARALLEL=2           jobs at once on this server
# MODEL3D_DECIMATION=200000    faces in the exported mesh
# MODEL3D_TEXTURE=2048         texture size (1024, 2048 or 4096)

# ----------------------------------------------------------------------
# 3D model generation (tripo3d.py)
# ----------------------------------------------------------------------
# Offered as a backend in the video bay when this is set: the result is
# a GLB mesh rather than a clip, and the bay shows a model viewer.
#
# NOT FREE. A search result claimed new accounts get 2,000 credits;
# a real new account returns {"balance": 0}. It is the CHEAPEST of the
# generative bays - roughly $0.20 a model against $0.45 for a PixVerse
# clip - but it needs a funded account, and the bay says so rather than
# failing on the first click.
#   https://platform.tripo3d.ai
TRIPO_API_KEY=

# DeepSeek, via OpenRouter, for the code bay: V3 answers and Deep mode
# thinks with R1. THESE COST MONEY PER MESSAGE - well under a cent for a
# V3 coding turn, a few cents for a long R1 one - and they are the only
# chat models in the app that do. Leave it unset and the code bay stays
# on pip 1.0 alone; set it and DeepSeek stands behind it, answering
# whenever the engine cannot.
OPENROUTER_API_KEY=

# The hard ceiling on that key, in dollars per UTC day, site-wide.
# Defaults to 1.00 if unset. The real cost of every response is read
# back from OpenRouter and added up; once the day reaches this the
# code bay falls to gpt-oss, which is free, and nothing more is
# spent until midnight UTC. Set it to 0 to switch Kimi off without
# removing the key. This matters because the site is public: without
# a ceiling, one stranger looping the code bay spends the balance.
OPENROUTER_DAILY_USD=1.00

# Email verification. Without these the six-digit code is printed to the
# server log instead of sent - the flow works either way, only the
# delivery changes. Gmail needs an app password, not your login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Encrypts the API keys users store for their own OpenAI/Anthropic/
# OpenRouter accounts. Kept OUT of the database on purpose: a database
# backup is then not a key leak. Without it, saving a provider key is
# refused rather than stored in the clear.
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Also needs: pip install cryptography
SETTINGS_ENCRYPTION_KEY=

# Web search for the chat's web_search tool, from Parallel
# (platform.parallel.ai). It's tried first, and the free sources take
# over when it's unset, out of credits or past the daily cap. "fast" mode
# is $1 per 1,000 searches. The cap protects a fixed credit balance from
# one script draining it.
PARALLEL_API_KEY=
PARALLEL_DAILY_LIMIT=2000
